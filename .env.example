# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитится в git (см. .gitignore) — секреты живут только локально.

# Ключ и адрес LLM-провайдера (Polza) для извлечения полей из договора
POLZA_API_KEY=
POLZA_API_URL=

# По умолчанию — локальный SQLite. Для Supabase используйте строку
# подключения из дашборда: Connect -> Connection string
DATABASE_URL=sqlite:///./database/contracts.db

# Где хранить сами файлы договоров: local | supabase
STORAGE_BACKEND=local

# Нужны только если STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_KEY=
